{
    "manufacturer": "Grant Patrick",
    "keyboard_name": "Anarchy_QPad",
    "maintainer": "anarchysoundllc",
    "development_board": "kb2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": false,
        "mousekey": false,
        "nkro": true,
        "led_matrix": true
    },
    "matrix_pins": {
        "cols": ["GP2", "GP26"],
        "rows": ["GP8", "GP6", "GP4"]
    },
    "usb": {
        "device_version": "1.0.5",
        "pid": "0x0400",
        "vid": "0x3A3A"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2}
            ]
        }
    },
    "led_matrix": {
        "driver": "is31fl3218",
        "max_brightness": 100,
        "sleep": false,
        "animations":{
            "breathing": true,
            "solid": true
        },
        "layout": [
           {"matrix": [0, 0], "x": 0, "y": 0, "flags": 0},
           {"matrix": [0, 1], "x": 1, "y": 0, "flags": 0},
           {"matrix": [1, 0], "x": 0, "y": 1, "flags": 0},
           {"matrix": [1, 1], "x": 1, "y": 1, "flags": 0},
           {"matrix": [2, 0], "x": 0, "y": 2, "flags": 0},
           {"matrix": [2, 1], "x": 1, "y": 2, "flags": 0} 
        ]
    }    
}